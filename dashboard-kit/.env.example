# Copy into the Next.js app's .env.local (and Vercel → Project → Environment Variables).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (no NEXT_PUBLIC_ prefix). Lets the agent call /api/summarize.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AGENT_WEBHOOK_SECRET=change-me

# Google AI Studio key for call summaries (server-only).
GEMINI_API_KEY=your-google-ai-key
GEMINI_MODEL=gemini-flash-latest
