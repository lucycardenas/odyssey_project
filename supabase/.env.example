# Copy to supabase/.env (scripts) — these are server-only, never commit the real file.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The one hardcoded caregiver account the seed script creates.
CAREGIVER_EMAIL=penelope@ithaca.dev
CAREGIVER_PASSWORD=change-me

# Optional: Google AI Studio key for the 3-line call summaries (npm run simulate / summarize).
# Without it a simple fallback summary is written.
GEMINI_API_KEY=your-google-ai-key
GEMINI_MODEL=gemini-flash-latest
