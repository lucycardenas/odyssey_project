# Copy to supabase/.env (scripts) — these are server-only, never commit the real file.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The one hardcoded caregiver account the seed script creates.
CAREGIVER_EMAIL=penelope@ithaca.dev
CAREGIVER_PASSWORD=change-me

# Optional, for `npm run simulate` to trigger the Gemini summary at the end.
DASHBOARD_URL=http://localhost:3000
AGENT_WEBHOOK_SECRET=change-me
